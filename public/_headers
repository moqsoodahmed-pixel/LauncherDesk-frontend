# Cloudflare Pages headers.
# The HTML must never be cached: after every deploy the script files get new names,
# and a stale index.html pointing at old names causes a blank white page.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# Built JS/CSS have a content hash in their names, so they can be cached for a long time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
